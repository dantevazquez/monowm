#!/bin/sh

set -eu

nobar=0
noswitcher=0

usage() {
    printf '%s\n' \
        'Usage: ./configure [--nobar] [--noswitcher]' \
        '' \
        '  --nobar       Do not build or install bar.c/lemonbar' \
        '  --noswitcher  Do not build the graphical window switcher'
}

for option in "$@"; do
    case "$option" in
        --nobar)
            nobar=1
            ;;
        --noswitcher)
            noswitcher=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'configure: unknown option: %s\n' "$option" >&2
            usage >&2
            exit 2
            ;;
    esac
done

tmp_file=config.mk.tmp
trap 'rm -f "$tmp_file"' EXIT HUP INT TERM

{
    printf '%s\n' '# Generated by ./configure. Run ./configure with no flags to reset.'
    printf 'NOBAR := %s\n' "$nobar"
    printf 'NOSWITCHER := %s\n' "$noswitcher"
} > "$tmp_file"
mv "$tmp_file" config.mk
trap - EXIT HUP INT TERM

printf 'Configured monowm (bar: %s, graphical switcher: %s)\n' \
    "$([ "$nobar" -eq 0 ] && printf enabled || printf disabled)" \
    "$([ "$noswitcher" -eq 0 ] && printf enabled || printf disabled)"
